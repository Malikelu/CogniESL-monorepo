    communicative_impact: 3
    flagged: false
    tier: 1
    source_rank: 1
    citations:
    - claim: M/I nouns are not inflected for number; plural endings dropped after numbers
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 282
      tier: 1
    - claim: Mass nouns pluralised by less proficient learners (*two milks, *many furnitures)
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
