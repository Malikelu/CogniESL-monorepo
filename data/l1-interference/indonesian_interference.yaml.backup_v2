  personal_pronouns:
    interference_patterns:
    - pattern: Repeated noun phrases instead of pronouns
      example: Many students work very hard. Many of them work all day in the library.
      frequency: 3
      persistence: 3
      communicative_impact: 2
      example_l1: Banyak siswa bekerja keras. Banyak dari mereka bekerja seharian di perpustakaan
      example_gloss: Many student work hard. Many of them work all-day in library
      example_wrong: Many students work very hard. Many of them work all day in the library. Is sad many students cannot pass the English test.
      explanation: M/I speakers often use repeated noun phrases where English would drop repeated elements or use anaphoric pronouns.
      etiology: interlingual
      flagged: false
      tier: 2
    examples:
    - wrong: Is sad many students cannot pass the English test.
      correct: It is sad that many students cannot pass the English test.
    why_it_happens: M/I speakers often use repeated noun phrases where English would drop repeated elements or use anaphoric pronouns. (Swan & Smith, p. 283)
    teacher_tips:
      how_to_explain: 'Teach: In English, use pronouns to avoid repeating nouns. Use ''it'' as a dummy subject for impersonal expressions.'
      where_to_start: Start with pronoun reference. Then teach dummy 'it' for impersonal expressions.
      sequencing: 'Week 1: Pronoun reference. Week 2: Dummy ''it''. Week 3: Practice. Week 4: Review.'
      exercises:
      - name: personal_pronouns Audit
        type: error-correction
        description: 20 sentences with personal pronoun errors from M/I learner writing.
        duration: 15
      - name: personal_pronouns Translation
        type: translation
        description: Translate 15 sentences focusing on personal pronouns.
        duration: 15
      - name: personal_pronouns Practice
        type: fill-in-the-blank
        description: 20 sentences practicing personal pronouns.
        duration: 10
      - name: personal_pronouns Error Hunt
        type: error-correction
        description: A paragraph with 10 personal pronoun errors.
        duration: 15
    sources:
