language: Indonesian
language_code: id
schema_version: '4.0'
grammar_points:
  articles:
    interference_patterns:
    - pattern: Omission of definite article (M/I has no articles)
      example: How was exam?
      frequency: 4
      persistence: 3
      communicative_impact: 3
      example_l1: ujian
      example_gloss: exam
      example_wrong: How was exam?
      example_correct: How was the exam?
      explanation: M/I has no articles. Demonstratives ini/itu can overlap with 'the' but optionally, so learners drop the definite article.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Indefinite article omission before abstract/mass nouns
      example: number of schools
      frequency: 4
      persistence: 3
      communicative_impact: 3
      example_l1: jumlah sekolah
      example_gloss: number of schools
      example_wrong: number of schools
      example_correct: a number of schools
      explanation: Learners drop the indefinite article before nouns relating to mass, quantity, and abstract concepts.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Indefinite article overuse
      example: My hobbies is a sleeping when I have a problems.
      frequency: 3
      persistence: 3
      communicative_impact: 2
      example_l1: hobi saya adalah tidur
      example_gloss: my hobby is sleeping
      example_wrong: My hobbies is a sleeping when I have a problems.
      example_correct: My hobby is sleeping when I have problems.
      explanation: Learners may overuse the indefinite article in contexts where English does not require one.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Definite/indefinite article confusion
      example: They have to deal with a economic recession.
      frequency: 3
      persistence: 3
      communicative_impact: 2
      example_l1: mereka harus menghadapi resesi ekonomi
      example_gloss: they must face economic recession
      example_wrong: They have to deal with a economic recession.
      example_correct: They have to deal with the economic recession.
      explanation: The definite article may be used instead of the indefinite and vice versa.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Article with demonstrative + plural
      example: It have the four legs.
      frequency: 3
      persistence: 3
      communicative_impact: 2
      example_l1: Itu punya empat kaki
      example_gloss: It has four legs
      example_wrong: It have the four legs.
      example_correct: It has four legs.
      explanation: Demonstratives are used with M/I reduplicated plurals, leading learners to use an inappropriate article with English plurals.
      etiology: interlingual
      flagged: false
      tier: 3
    examples:
    - wrong: How was exam?
      correct: How was the exam?
    - wrong: number of schools
      correct: a number of schools
    - wrong: They have to deal with a economic recession.
      correct: They have to deal with the economic recession.
    - wrong: It have the four legs.
      correct: It has four legs.
    - wrong: My hobbies is a sleeping when I have a problems.
      correct: My hobby is sleeping when I have problems.
    - wrong: They include the secondary school and a kindergarten.
      correct: They include a secondary school and a kindergarten.
    why_it_happens: M/I does not have articles. Demonstratives ini (this) and itu (that) can overlap with 'the' but this use is optional. Learners thus drop or misuse articles. (Swan & Smith, pp. 285-286)
    teacher_tips:
      how_to_explain: 'Teach: English REQUIRES articles. M/I has no article system, so learners must learn everything from scratch.'
      where_to_start: Start with the definite article omission pattern (most common).
      sequencing: 'Week 1: Definite article. Week 2: Indefinite article. Week 3: Article with plurals and mass nouns. Week 4: Review.'
      exercises:
      - name: articles Audit
        type: error-correction
        description: 20 sentences with articles errors from M/I learner writing.
        duration: 15
      - name: articles Translation
        type: translation
        description: Translate 15 sentences focusing on articles.
        duration: 15
      - name: articles Practice
        type: fill-in-the-blank
        description: 20 sentences practicing articles.
        duration: 10
      - name: articles Error Hunt
        type: error-correction
        description: A paragraph with 10 articles errors.
        duration: 15
    sources:
    - Swan & Smith Learner English (Indonesian)
    - Parrott Grammar for English Language Teachers
    source_count: 2
    source_type: textbook
    frequency: 4
    persistence: 3
    communicative_impact: 3
    flagged: false
    tier: 1
    source_rank: 1
    citations:
    - claim: M/I does not have articles; learners drop definite and indefinite articles
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, pp. 285-286
      tier: 1
    - claim: Learners drop indefinite article before mass/quantity nouns
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 285
      tier: 1
    - claim: Definite article may be used instead of indefinite and vice versa
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 286
      tier: 1
  word_order:
    interference_patterns:
    - pattern: SVO but flexible; subject dropped and order reversed
      example: From school I learn English.
      frequency: 3
      persistence: 3
      communicative_impact: 2
      example_l1: Dari sekolah saya belajar bahasa Inggris
      example_gloss: From school I learn English
      example_wrong: From school I learn English.
      example_correct: I learn English at school.
      explanation: M/I word order is SVO in formal contexts, but in casual speech the subject may be dropped and the word order reversed.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Topicalisation (fronting constituents for emphasis)
      example: This kind we don't have.
      frequency: 3
      persistence: 3
      communicative_impact: 2
      example_l1: Jenis ini kami tidak punya
      example_gloss: Kind this we not have
      example_wrong: This kind we don't have.
      example_correct: We don't have this kind.
      explanation: M/I speakers frequently topicalise constituents by placing them at the beginning of sentences.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Pronoun copying (noun + repeated pronoun)
      example: My mother, she wants me to help her cook.
      frequency: 3
      persistence: 3
      communicative_impact: 2
      example_l1: Ibu saya, dia mau saya bantu dia masak
      example_gloss: Mother my, she wants I help she cook
      example_wrong: My mother, she wants me to help her cook.
      example_correct: My mother wants me to help her cook.
      explanation: 'Pronoun copying: the subject or object is stated as a noun and then repeated in pronominalised form.'
      etiology: interlingual
      flagged: false
      tier: 3
    examples:
    - wrong: From school I learn English.
      correct: I learn English at school.
    - wrong: This kind we don't have.
      correct: We don't have this kind.
    - wrong: Ten per cent off we give our customers.
      correct: We give our customers ten per cent off.
    - wrong: My homework I have to do first.
      correct: I have to do my homework first.
    - wrong: My mother, she wants me to help her cook.
      correct: My mother wants me to help her cook.
    - wrong: Some Europeans, they like to eat here.
      correct: Some Europeans like to eat here.
    - wrong: My sister and me, we always fight.
      correct: My sister and I always fight.
    why_it_happens: M/I word order is SVO in formal contexts, but in casual speech the subject may be dropped and the word order reversed. Topicalisation and pronoun copying are common M/I discourse features. (Swan & Smith, pp. 284-285)
    teacher_tips:
      how_to_explain: 'Teach: English is strictly SVO. Fronting for emphasis is rare. Do not repeat the subject as a pronoun after stating it as a noun.'
      where_to_start: Start with basic SVO order. Then address topicalisation and pronoun copying.
      sequencing: 'Week 1: SVO order. Week 2: Topicalisation errors. Week 3: Pronoun copying. Week 4: Review.'
      exercises:
      - name: word_order Audit
        type: error-correction
        description: 20 sentences with word order errors from M/I learner writing.
        duration: 15
      - name: word_order Translation
        type: translation
        description: Translate 15 sentences focusing on word order.
        duration: 15
      - name: word_order Practice
        type: fill-in-the-blank
        description: 20 sentences practicing word order.
        duration: 10
      - name: word_order Error Hunt
        type: error-correction
        description: A paragraph with 10 word order errors.
        duration: 15
    sources:
    - Swan & Smith Learner English (Indonesian)
    - Parrott Grammar for English Language Teachers
    source_count: 2
    source_type: textbook
    frequency: 3
    persistence: 3
    communicative_impact: 2
    flagged: false
    tier: 1
    source_rank: 1
    citations:
    - claim: M/I word order is SVO but flexible; subject may be dropped and order reversed in casual speech
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 282
      tier: 1
    - claim: Topicalisation by fronting constituents is common in M/I
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, pp. 284-285
      tier: 1
    - claim: Pronoun copying (noun + repeated pronoun) is a feature of M/I discourse
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 285
      tier: 1
  questions:
    interference_patterns:
    - pattern: Wh-in-situ (no auxiliary inversion)
      example: Ali buy what?
      frequency: 5
      persistence: 4
      communicative_impact: 4
      example_l1: Ali beli apa?
      example_gloss: Ali buy what
      example_wrong: Ali buy what?
      example_correct: What did Ali buy?
      explanation: M/I allows wh-in-situ questions (the wh-word stays in its original position). English requires auxiliary inversion and do-support.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Omission of do-support in questions
      example: Why you so angry?
      frequency: 5
      persistence: 4
      communicative_impact: 4
      example_l1: Kenapa kamu marah?
      example_gloss: Why you angry
      example_wrong: Why you so angry?
      example_correct: Why are you so angry?
      explanation: M/I forms questions without do-support. English requires do/does/did for most questions (except with be and modals).
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Question tag reduction to isn't it? / is it?
      example: She will remember, isn't it?
      frequency: 4
      persistence: 4
      communicative_impact: 3
      example_l1: Dia akan ingat, bukan?
      example_gloss: She will remember, not
      example_wrong: She will remember, isn't it?
      example_correct: She will remember, won't she?
      explanation: English question tags tend to be reduced to only two forms (isn't it? and is it?), regardless of the auxiliary in the main clause.
      etiology: interlingual
      flagged: false
      tier: 3
    examples:
    - wrong: Ali buy what?
      correct: What did Ali buy?
    - wrong: What Ali buy?
      correct: What did Ali buy?
    - wrong: Why you so angry?
      correct: Why are you so angry?
    - wrong: Want to go where you?
      correct: Where do you want to go?
    - wrong: What that Ali buy?
      correct: What did Ali buy?
    - wrong: She will remember, isn't it?
      correct: She will remember, won't she?
    - wrong: They don't know you, is it?
      correct: They don't know you, do they?
    why_it_happens: M/I allows three question structures (in-situ, fully-moved, and focus) without do-support. English requires systematic auxiliary inversion. Question tags are reduced to two invariant forms. (Swan & Smith, pp. 288-289)
    teacher_tips:
      how_to_explain: 'Teach: Do/Does/Did + subject + base verb? Wh- questions require inversion. Question tags must match the auxiliary in the main clause.'
      where_to_start: Start with yes/no questions and do-support. Then teach wh- questions. Then question tags.
      sequencing: 'Week 1: Do/does questions. Week 2: Wh- questions. Week 3: Question tags. Week 4: Review.'
      exercises:
      - name: questions Audit
        type: error-correction
        description: 20 sentences with questions errors from M/I learner writing.
        duration: 15
      - name: questions Translation
        type: translation
        description: Translate 15 sentences focusing on questions.
        duration: 15
      - name: questions Practice
        type: fill-in-the-blank
        description: 20 sentences practicing questions.
        duration: 10
      - name: questions Error Hunt
        type: error-correction
        description: A paragraph with 10 questions errors.
        duration: 15
    sources:
    - Swan & Smith Learner English (Indonesian)
    - Parrott Grammar for English Language Teachers
    source_count: 2
    source_type: textbook
    frequency: 5
    persistence: 4
    communicative_impact: 4
    flagged: false
    tier: 1
    source_rank: 1
    citations:
    - claim: M/I allows wh-in-situ questions; learners produce *Ali buy what?
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, pp. 288-289
      tier: 1
    - claim: English question tags reduced to isn't it? and is it?
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 289
      tier: 1
  negation:
    interference_patterns:
    - pattern: Use of 'no' as negator (instead of 'not')
      example: She no understand my problems.
      frequency: 4
      persistence: 4
      communicative_impact: 3
      example_l1: Dia tidak paham masalah saya
      example_gloss: She not understand problems my
      example_wrong: She no understand my problems.
      example_correct: She does not understand my problems.
      explanation: M/I speakers use the negative particles no, not, never and not yet indiscriminately. Tidak is the general negator in M/I.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Omission of do-support in negation
      example: I not want to be a teacher.
      frequency: 5
      persistence: 4
      communicative_impact: 4
      example_l1: Saya tidak mau jadi guru
      example_gloss: I not want become teacher
      example_wrong: I not want to be a teacher.
      example_correct: I do not want to be a teacher.
      explanation: M/I negation uses pre-verbal particles (tidak, belum). English requires do-support for negation of lexical verbs.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Use of 'never' for single past negation
      example: The teacher never come to class today.
      frequency: 3
      persistence: 3
      communicative_impact: 3
      example_l1: Guru tidak datang ke kelas hari ini
      example_gloss: Teacher not come to class today
      example_wrong: The teacher never come to class today.
      example_correct: The teacher did not come to class today.
      explanation: M/I speakers use negative particles indiscriminately, including never where English requires did not.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Use of 'not yet' without auxiliary
      example: He not yet finish his homework.
      frequency: 3
      persistence: 3
      communicative_impact: 2
      example_l1: Dia belum selesaikan PR-nya
      example_gloss: He not-yet finish homework-his
      example_wrong: He not yet finish his homework.
      example_correct: He has not yet finished his homework.
      explanation: Belum (not yet) is used as a pre-verbal particle in M/I without auxiliary verbs.
      etiology: interlingual
      flagged: false
      tier: 3
    examples:
    - wrong: She no understand my problems.
      correct: She does not understand my problems.
    - wrong: I not want to be a teacher after I graduate.
      correct: I do not want to be a teacher after I graduate.
    - wrong: The teacher never come to class today.
      correct: The teacher did not come to class today.
    - wrong: He not yet finish his homework.
      correct: He has not yet finished his homework.
    - wrong: I said no to do it again.
      correct: I said I would not do it again.
    why_it_happens: M/I uses pre-verbal negative particles (tidak, belum) without do-support. English requires do/does/did + not for negation of lexical verbs. M/I speakers use no, not, never and not yet indiscriminately. (Swan & Smith, p. 289)
    teacher_tips:
      how_to_explain: 'Teach: do/does/did + not + base verb. M/I uses tidak before the verb; English needs the auxiliary do.'
      where_to_start: Start with do-support in negation. Then address no vs. not confusion.
      sequencing: 'Week 1: Do/does/did + not. Week 2: No vs. not. Week 3: Never vs. did not. Week 4: Review.'
      exercises:
      - name: negation Audit
        type: error-correction
        description: 20 sentences with negation errors from M/I learner writing.
        duration: 15
      - name: negation Translation
        type: translation
        description: Translate 15 sentences focusing on negation.
        duration: 15
      - name: negation Practice
        type: fill-in-the-blank
        description: 20 sentences practicing negation.
        duration: 10
      - name: negation Error Hunt
        type: error-correction
        description: A paragraph with 10 negation errors.
        duration: 15
    sources:
    - Swan & Smith Learner English (Indonesian)
    - Parrott Grammar for English Language Teachers
    source_count: 2
    source_type: textbook
    frequency: 4
    persistence: 4
    communicative_impact: 3
    flagged: false
    tier: 1
    source_rank: 1
    citations:
    - claim: M/I speakers use negative particles no, not, never and not yet indiscriminately
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 289
      tier: 1
    - claim: M/I uses pre-verbal tidak; English requires do-support for negation
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 289
      tier: 1
  phonology:
    interference_patterns:
    - pattern: /ae/ and /e/ conflated into /e/
      example: hat -> /het/
      frequency: 4
      persistence: 4
      communicative_impact: 3
      example_l1: N/A (phonological)
      example_gloss: N/A
      example_wrong: hat -> /het/, ankle -> /enkal/, grammar -> /grems(r)/
      example_correct: hat -> /haet/, ankle -> /aenkl/, grammar -> /graem@r/
      explanation: Indonesian has only six vowels. /ae/ and /e/ are conflated into /e/.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Unaspirated /p, t, k/ (sound like /b, d, g/)
      example: pin sounds like bin
      frequency: 4
      persistence: 4
      communicative_impact: 3
      example_l1: N/A (phonological)
      example_gloss: N/A
      example_wrong: pin sounds like bin; tile sounds like dial; cot sounds like got; jump -> jum', sergeant -> saajaan, ask -> as'
      example_correct: pin (aspirated), tile (aspirated), cot (aspirated), jump, sergeant, ask
      explanation: /p, t, k/ are always unaspirated in M/I, making them sound close to /b, d, g/. In final position they are unreleased or omitted.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: /f/ replaced by /p/
      example: prefer -> preper
      frequency: 4
      persistence: 4
      communicative_impact: 3
      example_l1: N/A (phonological)
      example_gloss: N/A
      example_wrong: prefer -> preper, favour -> pavour/papour, film -> pilam
      example_correct: prefer, favour, film
      explanation: /f/ in any position is frequently replaced by /p/ by less proficient speakers.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: /v/ replaced by /f/ or /p/
      example: very -> fery or pery
      frequency: 4
      persistence: 4
      communicative_impact: 3
      example_l1: N/A (phonological)
      example_gloss: N/A
      example_wrong: very -> fery/pery; final /v/ dropped
      example_correct: very
      explanation: /v/ is very rare in M/I; when used it occurs before vowels only. Students replace /v/ by /f/ or /p/, especially at the ends of words.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: /th/ -> /t/ and /dh/ -> /d/
      example: thin -> tin, that -> dat
      frequency: 4
      persistence: 4
      communicative_impact: 3
      example_l1: N/A (phonological)
      example_gloss: N/A
      example_wrong: thin -> tin, thought -> tot, thousand -> tousan; that -> dat, there -> dere
      example_correct: thin, thought, thousand, that, there
      explanation: Learners generally pronounce /th/ as /t/ and /dh/ as /d/.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Final voiced stops and fricatives dropped
      example: bulb -> bul, old -> oul
      frequency: 4
      persistence: 4
      communicative_impact: 3
      example_l1: N/A (phonological)
      example_gloss: N/A
      example_wrong: bulb -> bul, old -> oul, hand -> haan
      example_correct: bulb, old, hand
      explanation: M/I words cannot end in voiced stops /b, d, g/ or the fricatives /v, z, sh/ or the affricates /ch, j/. Learners drop these sounds at the ends of English words.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Consonant cluster simplification or schwa insertion
      example: stand -> Stan, film -> filom
      frequency: 4
      persistence: 4
      communicative_impact: 3
      example_l1: N/A (phonological)
      example_gloss: N/A
      example_wrong: stand -> Stan, talked -> talk; film -> filom, project -> porojek, clinic -> klinik
      example_correct: stand, talked, film, project, clinic
      explanation: Relatively few consonant clusters are permitted in M/I. The most frequently occurring syllable structure is CVC. Students simplify clusters or insert a schwa vowel.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Syllable-timed rhythm; no reduction of function words
      example: Full pronunciation of auxiliaries and prepositions
      frequency: 4
      persistence: 4
      communicative_impact: 2
      example_l1: N/A (phonological)
      example_gloss: N/A
      example_wrong: Slow, staccato rhythm; auxiliaries and prepositions given full pronunciation; contracted forms avoided
      example_correct: Natural English rhythm with reduced forms (I'm, don't, gonna)
      explanation: Most varieties of M/I have a syllable-timed rhythm. Function words are almost never reduced. Students give English auxiliary verbs and prepositions their full written pronunciation.
      etiology: interlingual
      flagged: false
      tier: 3
    examples:
    - wrong: hat -> /het/
      correct: hat -> /haet/
    - wrong: prefer -> preper
      correct: prefer
    - wrong: thin -> tin
      correct: thin
    - wrong: bulb -> bul
      correct: bulb
    - wrong: stand -> Stan
      correct: stand
    why_it_happens: The M/I and English phonological systems are very different. English has 22 vowels and diphthongs and 24 consonants. Indonesian has only six vowels and three diphthongs. M/I has 19 native consonants. M/I syllable structure is predominantly CVC with few consonant clusters. (Swan & Smith, pp. 280-282)
    teacher_tips:
      how_to_explain: 'Teach: Focus on sounds that don''t exist in M/I. Practice minimal pairs. Drill consonant clusters. Teach English rhythm and connected speech.'
      where_to_start: Start with the most problematic sounds (/f/ vs /p/, /v/, /th/, /dh/). Then consonant clusters. Then rhythm.
      sequencing: 'Week 1: /f/ vs /p/ and /v/. Week 2: /th/ and /dh/. Week 3: Consonant clusters. Week 4: Rhythm and connected speech.'
      exercises:
      - name: phonology Audit
        type: error-correction
        description: 20 sentences with phonology errors.
        duration: 15
      - name: phonology Translation
        type: translation
        description: Translate 15 sentences focusing on phonology.
        duration: 15
      - name: phonology Practice
        type: fill-in-the-blank
        description: 20 sentences practicing phonology.
        duration: 10
      - name: phonology Error Hunt
        type: error-correction
        description: A paragraph with 10 phonology errors.
        duration: 15
    sources:
    - Swan & Smith Learner English (Indonesian)
    - Underhill Sound Foundations
    source_count: 2
    source_type: textbook
    frequency: 4
    persistence: 4
    communicative_impact: 3
    flagged: false
    tier: 1
    source_rank: 1
    citations:
    - claim: /ae/ and /e/ conflated into /e/ in M/I English
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 280
      tier: 1
    - claim: /p, t, k/ always unaspirated; final position unreleased or omitted
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 281
      tier: 1
    - claim: /f/ replaced by /p/; /v/ replaced by /f/ or /p/
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 281
      tier: 1
    - claim: /th/ -> /t/; /dh/ -> /d/
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 281
      tier: 1
    - claim: Final voiced stops and fricatives dropped
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 281
      tier: 1
    - claim: Consonant clusters simplified or schwa inserted
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 281
      tier: 1
    - claim: Syllable-timed rhythm; function words not reduced
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 282
      tier: 1
  countability:
    interference_patterns:
    - pattern: Pluralization of uncountable nouns
      example: two milks, many furnitures
      frequency: 4
      persistence: 4
      communicative_impact: 3
      example_l1: dua susu, banyak furnitur
      example_gloss: two milk, many furniture
      example_wrong: two milks / three bags of flours / many furnitures / a lot of butters
      example_correct: two glasses of milk / three bags of flour / a lot of furniture / a lot of butter
      explanation: Less proficient learners may pluralise English mass nouns. M/I nouns are not inflected for number and reduplication is used for plurals.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Abstract nouns treated as countable
      example: five year experiences, very good educations
      frequency: 3
      persistence: 3
      communicative_impact: 2
      example_l1: lima tahun pengalaman, pendidikan sangat baik
      example_gloss: five year experience, education very good
      example_wrong: some works to do / five year experiences / very good educations
      example_correct: some work to do / five years of experience / a very good education
      explanation: Abstract nouns which can be mass or count in English produce errors when learners treat them as countable.
      etiology: interlingual
      flagged: false
      tier: 3
    - pattern: Plural endings dropped after numbers or quantifiers
      example: She have three sister and two brother.
      frequency: 4
      persistence: 4
      communicative_impact: 3
      example_l1: Dia punya tiga saudara perempuan dan dua saudara laki-laki
      example_gloss: She has three sister and two brother
      example_wrong: She have three sister and two brother. / a number of boy / one of the man / a few doctor
      example_correct: She has three sisters and two brothers. / a number of boys / one of the men / a few doctors
      explanation: M/I nouns are not inflected for number. Plural endings are particularly likely to be dropped after numbers or plural quantifiers.
      etiology: interlingual
      flagged: false
      tier: 3
    examples:
    - wrong: two milks
      correct: two glasses of milk
    - wrong: many furnitures
      correct: a lot of furniture
    - wrong: She have three sister and two brother.
      correct: She has three sisters and two brothers.
    - wrong: a number of boy
      correct: a number of boys
    - wrong: five year experiences
      correct: five years of experience
    - wrong: The teacher gave too much corrections.
      correct: The teacher gave too many corrections.
    why_it_happens: M/I nouns are not inflected for number. Plurals are formed by reduplication (kucing-kucing = cats), though not after numerals. Learners drop English plural endings and may pluralise mass nouns. (Swan & Smith, pp. 282-283)
    teacher_tips:
      how_to_explain: 'Teach: English plurals add -s/-es. Mass nouns cannot be pluralised. After numbers, nouns must be plural. Common uncountables: homework, advice, information, furniture, luggage.'
      where_to_start: Start with regular plurals. Then teach mass/count distinction. Then quantifiers (much/many).
      sequencing: 'Week 1: Regular plurals. Week 2: Mass vs count nouns. Week 3: Quantifiers (much/many, few/little). Week 4: Review.'
      exercises:
      - name: countability Audit
        type: error-correction
        description: 20 sentences with countability errors from M/I learner writing.
        duration: 15
      - name: countability Translation
        type: translation
        description: Translate 15 sentences focusing on countability.
        duration: 15
      - name: countability Practice
        type: fill-in-the-blank
        description: 20 sentences practicing countability.
        duration: 10
      - name: countability Error Hunt
        type: error-correction
        description: A paragraph with 10 countability errors.
        duration: 15
    sources:
    - Swan & Smith Learner English (Indonesian)
    - Parrott Grammar for English Language Teachers
