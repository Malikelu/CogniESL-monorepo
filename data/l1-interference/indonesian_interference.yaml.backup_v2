    frequency: 5
    persistence: 5
    communicative_impact: 4
    flagged: false
    tier: 1
    source_rank: 1
    citations:
    - claim: M/I has nothing corresponding to English distinction between simple past and present perfect
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, pp. 286-287
      tier: 1
    - claim: M/I uses sekarang for ongoing action; learners transfer without -ing auxiliary
      source: Swan & Smith (2001) Learner English, 2nd ed., Cambridge University Press
      location: Malay/Indonesian speakers, p. 287
      tier: 1
    - claim: Akan indicates future; learners have problems with English future forms
